# ======================================================================
# WebRTC 项目 Docker 环境配置文件
# 适用于 Windows 和 macOS
# ======================================================================

# ----------------------------------------------------------------------
# MySQL 配置
# ----------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=webrtc_db
MYSQL_USER=root
MYSQL_PORT=3306

# ----------------------------------------------------------------------
# 后端服务配置
# ----------------------------------------------------------------------
BACKEND_PORT=8081

# CORS 允许的源地址（用逗号分隔，不要有空格）
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# ----------------------------------------------------------------------
# 前端配置
# ----------------------------------------------------------------------
# 前端运行模式: production 或 development
# production: 使用nginx提供静态文件（默认）
# development: 使用vite开发服务器，支持热更新
# 注意：切换模式时需要同时更新 FRONTEND_INTERNAL_PORT
FRONTEND_MODE=production

# 前端端口（宿主机访问端口）
FRONTEND_PORT=80

# 前端内部端口（容器内端口）
# production模式: 80
# development模式: 5173
FRONTEND_INTERNAL_PORT=80

# 开发模式下的后端主机（Docker容器内部使用）
VITE_API_HOST=webrtc-service

# ----------------------------------------------------------------------
# Docker 配置
# ----------------------------------------------------------------------
COMPOSE_PROJECT_NAME=webrtc
TZ=Asia/Shanghai
